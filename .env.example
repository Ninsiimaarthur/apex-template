# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (admin portal + live content) ---
# Project Settings -> API. Leave blank to run on siteConfig.ts only.
# See supabase/README.md for the full setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (email notifications for new leads) ---
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Where lead emails are delivered (defaults to the email in your business settings)
CONTACT_TO_EMAIL=
# Must be a verified domain/sender in Resend. The default works for testing only.
CONTACT_FROM_EMAIL="Website Leads <onboarding@resend.dev>"

# --- Supabase lead storage (optional) ---
# Only needed if you uncomment saveToSupabase() in src/app/api/contact/route.ts.
# Server-side only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
